# Dockerfile for building FFmpeg-MSwitch on Linux
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    yasm \
    nasm \
    pkg-config \
    git \
    libx264-dev \
    libx265-dev \
    libaom-dev \
    libsrt-openssl-dev \
    libfreetype6-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy FFmpeg source
COPY . /build/

# Build script will be run as command
CMD ["./releases/scripts/build-linux.sh"]
